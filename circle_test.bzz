# Use Ctrl + Click (Cmd + Click on Mac) to move a selected robot to a different location

# Put your global variables here
# Variables are from previously provided synchronization algorithm

# Speed values taken from Pinciroli's paper
# Turn Right
v_L0 = 9.
v_R0 = 1.

# Turn Left
v_L1 = 3.
v_R1 = 9.

hasneighbor = 0
#value = { .hasneigh = 0 }


# This function is executed every time you press the 'execute' button
function init() {
	hasneighbor = 0
	value = { .hasneigh = 0 }
accum = { .res= 0 }
}



# This function is executed at each time step
# It must contain the logic of your controller
function step() {
	# Range and bearing part

#	hasneighbor = neigbors.reduce(function(rid,data,value){
	#	if((math.abs(neighbors.azimuth) <= math.pi/24) and (neighbors.distance <=200)){
			# If it can see a neighbor within its frontal range, has_neigh flips to 1, and wheel speed switches
	#		value.hasneigh = 1
		#}; 
	#	return value; 
	#}, 
	#{.hasneigh = 0})
info = neighbors.map(
  function(rid, data) {
		value = { .hasneigh = 0 }
		# (math.abs(neighbors.azimuth) <= (math.pi/24)) and (neighbors.distance <=200)
    if((math.abs(data.azimuth) <= (math.pi/24)) and (data.distance <=2000)){
			# If it can see a neighbor within its frontal range, has_neigh flips to 1, and wheel speed switches
			value.hasneigh = 1
		}; 
		return value; 
  })
result = info.reduce(function(rid, data, accum) {
    accum.res = accum.res + data.hasneigh
    return accum
  }, {.res = 0})
log(result.res)

	if (result.res >= 1){
		# can see a robot
		set_wheels(v_L1, v_R1)
	} else {
		# cannot see a robot
		set_wheels(v_L0, v_R0)
	}

}

